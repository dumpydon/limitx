# Backend URL embedded into the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins accepted by the FastAPI CORS policy.
LIMITX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional future LLM integration. The shipped Replay Analyst uses a deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
